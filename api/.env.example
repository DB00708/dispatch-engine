# Copy to .env for local (non-Docker) runs. Every value has a working default.
STORAGE=memory              # memory | postgres
CACHE=none                  # none | redis
DATABASE_URL=postgresql+psycopg://dispatch:dispatch@localhost:5432/dispatch
REDIS_URL=redis://localhost:6379/0
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080
LOG_LEVEL=INFO
# FRONTEND_DIST=../ui/dist   # serve the built UI from the API (single image)
